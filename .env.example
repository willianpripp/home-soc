# Copy to .env and fill in. .env is gitignored and never committed.
HOMESOC_DB_PASSWORD=change-me

# Where the Trivy run directories live. On the lab host this is written by the
# container_scan Ansible role in the homelab repo.
HOMESOC_SCAN_DIR=/srv/scan

# Loopback port for the database. Only needs changing if something else on the
# host already has 5433.
HOMESOC_DB_PORT=5433
